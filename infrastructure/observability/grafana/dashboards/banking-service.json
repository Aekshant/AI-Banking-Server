      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"banking-service\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
