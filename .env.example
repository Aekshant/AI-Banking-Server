# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# Postgres (used by docker-compose, banking-service and the seed script)
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bankdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Redis (backs rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# banking-service
PORT=8001
LOG_LEVEL=info            # debug | info | warn | error
LOG_FORMAT=json           # json | text (text is easier to read in a terminal)

# Tracing: set to send traces to Tempo when running with `make run`.
# The container (--profile app) always sends to Tempo.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Rate limiting: token bucket per client IP, as capacity/refill_per_second.
# Capacity is the burst size; refill is the sustained rate.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ=30/10
RATE_LIMIT_TRANSFER=10/1
RATE_LIMIT_LOAN=10/2

# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Leave empty
# unless the service runs behind a proxy, or clients can spoof their IP.
TRUSTED_PROXIES=

# Optional: overrides all POSTGRES_* settings above
# DATABASE_URL=postgres://user:password@localhost:5432/bankdb?sslmode=disable

# Observability (--profile observability)
GRAFANA_ADMIN_PASSWORD=change-me
